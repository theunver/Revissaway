# Google Translate API Key
# Get your API key from: https://console.cloud.google.com/apis/credentials
GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key_here

# --- Contact form email (app/api/contact/route.ts) ---
# Set these in Vercel → Settings → Environment Variables (Preview and Production). Never commit real values.
# Gmail / Google Workspace account that sends the enquiry emails (2-Step Verification on; use an App Password).
GMAIL_USER=
GMAIL_PASS=
# Optional: single recipient for enquiries. Defaults to info@revissaway.com.au when unset or invalid.
CONTACT_TO=
# Preview/Development only: comma-separated test addresses that may submit the form. All other addresses are
# refused on non-production deployments (no real enquiries in Preview). Not used in Production.
PREVIEW_TEST_EMAILS=
